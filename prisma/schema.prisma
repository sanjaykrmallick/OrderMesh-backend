generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  WAREHOUSE
  OPERATIONS
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PAYMENT_PENDING
  PAID
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  OUT_OF_STOCK
}

enum InventoryAdjustmentType {
  RESTOCK
  DAMAGE
  CORRECTION
  RETURN
  MANUAL
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  PAYPAL
}

enum PaymentAttemptStatus {
  CREATED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentWebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum NotificationType {
  ORDER_CREATED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  ORDER_PROCESSING
  ORDER_PACKED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  INVENTORY_ALERT
  SYSTEM
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  UNREAD
  READ
}

enum AnalyticsEventType {
  USER_REGISTERED
  PRODUCT_VIEWED
  CART_CREATED
  CART_ITEM_ADDED
  ORDER_CREATED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  ORDER_CANCELLED
  ORDER_PROCESSING
  ORDER_PACKED
  ORDER_SHIPPED
  ORDER_DELIVERED
  INVENTORY_RESERVED
  INVENTORY_RELEASED
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String?
  phone        String   @unique
  isActive     Boolean  @default(true)
  role         UserRole @default(CUSTOMER)

  refreshTokenHash String?

  carts  Cart[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model Category {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([isActive])
  @@index([createdAt])
}

model Product {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  sku         String  @unique
  name        String
  slug        String  @unique
  description String?

  priceInCents Int

  imageUrl String?

  isActive Boolean @default(true)

  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  cartItems  CartItem[]
  orderItems OrderItem[]

  inventory Inventory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([name])
  @@index([createdAt])
}

model Cart {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  cartId String @db.ObjectId
  cart   Cart   @relation(fields: [cartId], references: [id])

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  quantity Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
}

model Inventory {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productId String  @unique @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  availableQuantity Int @default(0)
  reservedQuantity  Int @default(0)

  status InventoryStatus @default(AVAILABLE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryAdjustment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  productId String @db.ObjectId

  quantity Int

  type InventoryAdjustmentType

  reason String?

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Order {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderNumber String @unique

  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  items OrderItem[]

  totalAmountInCents Int
  status             OrderStatus @default(PENDING)

  payment Payment?

  shippingAddress Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId String @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  productName String
  sku         String

  quantity          Int
  unitPriceInCents  Int
  totalPriceInCents Int

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  orderId String @unique @db.ObjectId
  order   Order  @relation(fields: [orderId], references: [id])

  amountInCents Int
  status        PaymentStatus @default(PENDING)

  attempts PaymentAttempt[]

  transactionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PaymentAttempt {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  paymentId String  @db.ObjectId
  payment   Payment @relation(fields: [paymentId], references: [id])

  provider PaymentProvider

  attemptNumber Int @default(1)

  status PaymentAttemptStatus @default(CREATED)

  amountInCents Int

  providerPaymentId String?

  idempotencyKey String @unique

  lastWebhookEventId String?

  failureCode    String?
  failureMessage String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
  @@index([provider])
  @@index([status])
  @@index([providerPaymentId])
  @@index([provider, providerPaymentId])
}

model PaymentWebhookEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  provider PaymentProvider

  eventId String @unique

  eventType String

  providerPaymentId String?

  status PaymentWebhookEventStatus @default(RECEIVED)

  payload Json?

  errorMessage String?

  processingStartedAt DateTime?

  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([status])
  @@index([providerPaymentId])
  @@index([provider, providerPaymentId])
  @@index([createdAt])
}

model Notification {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId String @db.ObjectId

  type NotificationType

  channel NotificationChannel @default(IN_APP)

  status NotificationStatus @default(UNREAD)

  title String

  message String

  entityType String?
  entityId   String?

  metadata Json?

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([type])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  type AnalyticsEventType

  userId String? @db.ObjectId

  orderId String? @db.ObjectId

  productId String? @db.ObjectId

  amountInCents Int?

  quantity Int?

  metadata Json?

  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([type])
  @@index([userId])
  @@index([orderId])
  @@index([productId])
  @@index([occurredAt])
  @@index([type, occurredAt])
}

model DailyAnalytics {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  date DateTime @unique

  totalOrders Int @default(0)

  successfulOrders Int @default(0)

  cancelledOrders Int @default(0)

  totalRevenueInCents Int @default(0)

  totalPaymentsFailed Int @default(0)

  totalProductsSold Int @default(0)

  totalUsersRegistered Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}
